/target
/user/target
**/*.rs.bk
**/*.swp
.DS_Store
.claude/worktrees/

# Build artifacts produced by `make all`.
/kernel-rv
/kernel-la
# Local SYSTRACE=1 build used for ad-hoc debugging
/kernel-rv-trace
# Zeroed scratch disks `make all` generates for the writable `-drive
# file=disk*.img` scratch device (LTP tst_device). Regenerated each build.
/disk.img
/disk-la.img

# `make prepare` materialises these from cargo/ on contest boxes
# where hidden dirs got stripped on clone. Don't commit them — the
# canonical copy lives under cargo/ and kernel/cargo/.
/.cargo/
/kernel/.cargo/

# in-kernel symbol blobs (generated by `make` two-pass)
ksyms-*.bin

# single_ltp / single_bench harness build artifacts (local dev only)
kernel-la-single
/kernel-rv-bench
/kernel-la-bench
# any suffixed kernel build output (single_bench/debug/contest local copies,
# e.g. kernel-rv-cyc, kernel-la-new, kernel-la-pc) — never committed; built
# fresh from cargo + `cp target/.../kernel kernel-<arch>...`.
/kernel-rv-*
/kernel-la-*
